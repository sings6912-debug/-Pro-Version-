{
  "rules": {
    ".read": false,
    ".write": false,
    "licenses": {
      ".read": false,
      ".write": false,
      "$licenseKey": {
        ".read": "auth != null",
        ".write": false
      }
    },
    "tenant_data": {
      "$licenseKey": {
        ".read": "auth != null && root.child('licenses').child($licenseKey).exists() && root.child('licenses').child($licenseKey).child('active').val() !== false",
        ".write": "auth != null && root.child('licenses').child($licenseKey).exists() && root.child('licenses').child($licenseKey).child('active').val() !== false"
      }
    }
  }
}